# Base de datos: dos usuarios distintos.
# DATABASE_URL_OWNER solo se usa para migraciones (dueño de las tablas).
# DATABASE_URL usa el rol de aplicación, que NO puede saltarse RLS.
DATABASE_URL_OWNER=postgres://microslab_owner:owner_dev_password@localhost:5432/microslab
DATABASE_URL=postgres://microslab_app:app_dev_password@localhost:5432/microslab

REDIS_URL=redis://localhost:6379

# Dominio base: cada laboratorio vive en <subdominio>.<BASE_DOMAIN>
BASE_DOMAIN=microslab.local

# Firma de tokens en desarrollo (en producción: gestor de secretos)
JWT_SECRET=cambia-esto-en-desarrollo

LOG_LEVEL=info
